{
  "name": "docmind",
  "version": "0.1.6",
  "productName": "DocMind",
  "description": "Ask your project's documentation. Everything stays local.",
  "main": "./out/main/index.js",
  "author": "DocMind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markuz899/docMindApp.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "native:node": "node scripts/native.mjs node",
    "native:electron": "node scripts/native.mjs electron",
    "dev": "npm run native:electron && electron-vite dev",
    "start": "npm run native:electron && electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run native:node && vitest run",
    "test:watch": "vitest",
    "package": "npm run build && npm run native:electron && electron-builder --dir",
    "dist": "npm run build && npm run native:electron && electron-builder",
    "seed:demo": "vite-node -c vitest.config.ts scripts/seed-demo.ts --",
    "test:e2e": "npm run native:node && DOCMIND_E2E=1 vitest run tests/e2e.local-model.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.4.2",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "prebuild-install": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.6.0"
  }
}
